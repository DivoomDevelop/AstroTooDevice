test_gpio2 = port:PA17<5><1><default><default>

;--------------------------------
;[usbc0]：控制器0的配置。
;usb_used：USB使能标志。置1，表示系统中USB模块可用,置0,则表示系统USB禁用。
;usb_port_type：USB端口的使用情况。 0：device only;1：host only;2：OTG
;usb_detect_type：USB端口的检查方式。0：不做检测;1：vbus/id检查;2：id/dpdm检查
;usb_detect_mode：USB端口的检查方式。0：线程轮询;1：id中断触发
;usb_id_gpio：USB ID pin脚配置。具体请参考gpio配置说明。
;usb_det_vbus_gpio：USB DET_VBUS pin脚配置。具体请参考gpio配置说明。
;usb_drv_vbus_gpio：USB DRY_VBUS pin脚配置。具体请参考gpio配置说明。
;usb_drv_vbus_type:	vbus设置方式。0：无; 1：gpio; 2：axp。
;usb_det_vbus_gpio: "axp_ctrl",表示axp 提供
;usb_restrict_gpio  usb限流控制pin
;usb_restric_flag:  usb限流标置
;usbh_driver_level:	usb做host时驱动能力0x0-0xf
;usbd_driver_level:	usb做device时驱动能力0x0-0xf
;usbh_irq_flag:	usb host中断标志 设置为0x4000可为唤醒源，设置为0不具有唤醒功能。
;usbd_irq_flag: usb device中断标志 设置为0x4000可为唤醒源，设置为0不具有唤醒功能。
;--------------------------------
;--------------------------------
;---       USB0控制标志
;--------------------------------
[usbc0]
usb_used                = 1
usb_port_type           = 0
usb_detect_type         = 1
usb_detect_mode		    = 0
;usb_id_gpio             = port:PD00<0><0><default><default>
;usb_det_vbus_gpio       = port:PA01<0><0><default><default>
;usb_drv_vbus_gpio       = port:PE02<1><0><default><0>
usb_drv_vbus_type       = 0
usb_host_init_state     = 0
usb_restric_flag        = 0
usb_restric_voltage     = 3550000
usb_restric_capacity    = 5
usbd_irq_flag			= 0
usbh_irq_flag			= 0

;-----------------------------------------------------------------------------
;sunxi rtos audio driver v2
;-----------------------------------------------------------------------------
[i2s0_mach]
format = "i2s"
bitclock-inversion = 0
frame-inversion = 0
bitclock-master = "codec"
frame-master = "codec"
slot-num = 2
slot-width = 16
playback-only = 0
capture-only = 0
cpu-pll-fs = 1
mclk-fs = 1
mclk-fp = "11289600,12288000"
codec-pll-fp = "22579200, 24576000"
codec-pllin-mode = 0
codec-pllin-fs = 1
codec-pllout-mode = 0
codec-pllout-fs = 1
cpu = "i2s0_plat"
cpu-id = 0

[i2s0_plat]
playback-cma		= 8
capture-cma		= 8
tdm-num			= 0
tx-pin			= "0"
tx-pin0-chmap		= "0,1,2,3"
rxfifo-pinmap		= "0,0,0,0"
rxfifo-chmap		= "0,1,2,3"
tx-lsb-first		= "false"
rx-lsb-first		= "false"
i2s-pins-0		= port:PD06<4><0><1><default>
i2s-pins-1		= port:PD07<4><0><1><default>
i2s-pins-2		= port:PD08<4><0><1><default>
i2s-pins-3		= port:PD09<4><0><1><default>

[codec_mach]
cpu = "codec_plat"
codecs-num = 1
codecs-0 = "codec"

[codec_plat]
playback_cma	= 8
capture_cma		= 8

[codec]
dac_vol	= 63
dacl_vol	= 160
dacr_vol	= 160
hpout_gain	= 7
adc1_vol	= 160
adc1_gain	= 15
lineinl_gain	= 6
fminl_gain	= 6
adcdrc_en     	= 0
adchpf_en     	= 0
dacdrc_en     	= 0
dachpf_en     	= 0
adc1_src	= 1
hpoutl_en	= 1
hpoutr_en	= 1
spk_en		= 1
pa-pin-max  = 0
;pa-pin-0    = port:PE10<1><default><1><1>
pa-pin-msleep-0 = 100

[owa_mach]
playback-only = 1
cpu = "owa_plat"

[owa_plat]
playback-cma	= 8
capture-cma		= 8
owa-pins-0		= port:PE6<6><0><1><default>

;----------------------------------------------------------------------------------
;i2c configuration
;twi_drv_used : 是否使用TWI的drv工作模式，drv工作模式是芯片的IP功能，不是指的TWI的软件驱动，详情请参考芯片手册。
;----------------------------------------------------------------------------------
;[twi1]
;twi_drv_used    = 0
;twi1_scl         = port:PE00<4><1><0><default>
;twi1_sda         = port:PE01<4><1><0><default>

;----------------------------------------------------------------------------------
;resistance tp configuration
;----------------------------------------------------------------------------------
[rtp_para]
rtp_used 				= 0
rtp_adjust_cfg_path     = "/userdata/tp.cfg"
rtp_screen_max_x        = 1024
rtp_screen_max_y        = 600

[sdcard_global]
used_card_no    = 0x04
;used_card_no = 0x01, when use card0
;used_card_no = 0x02, when use card1
;used_card_no = 0x03, when use card0 & card1
;used_card_no = 0x04, when use card2
;used_card_no = 0x05, when use card0 & card2
internal_card = 0x04
;internal_card = 0x00, 无内置卡内置卡
;internal_card = 0x01, card0 做内置卡
;internal_card = 0x02, card1 做内置卡
;internal_card = 0x04, card2 做内置卡
;如果该卡是内置卡，则检测脚未注释，也不会使用
[sdc0_gpios]
detect_pin  = port:PF6<0><1><3><default>
;[sdc1det_para]
;msdet_para   = port:PG6<0><1><1><default>

[sdc0]
sdc0_used          = 1
bus-width      = 4
sdc0_d1            = port:PF00<2><1><2><default>
sdc0_d0            = port:PF01<2><1><2><default>
sdc0_clk           = port:PF02<2><1><2><default>
sdc0_cmd           = port:PF03<2><1><2><default>
sdc0_d3            = port:PF04<2><1><2><default>
sdc0_d2            = port:PF05<2><1><2><default>
;cd-gpios           = port:PF06<0><1><2><default>
;card-pwr-gpios     = port:PL08<1><1><2><default>
;ctl-spec-caps      = 0x4
;sunxi-power-save-mode =
;sunxi-dis-signal-vol-sw =
;vmmc="vcc-sdcv"
;vqmmc="vcc-sdcvq33"
;vdmmc="vcc-sdcvd"
;mmc-ddr-3_3v    = 1
;sd-uhs-sdr50 = 1
;sd-uhs-ddr50 = 1
;sd-uhs-sdr104 = 1
max-frequency   = 50000000


[sdc2]
sdc2_used = 1
bus-width= 4
sdc2_clk           = port:PC0<2><1><2><default>
sdc2_cmd           = port:PC1<2><1><2><default>
sdc2_d0            = port:PC4<2><1><2><default>
sdc2_d1            = port:PC3<2><1><2><default>
sdc2_d2            = port:PC2<2><1><2><default>
sdc2_d3            = port:PC5<2><1><2><default>
;ctl-spec-caps = 0x4
;sunxi-power-save-mode = 1
;sunxi-dis-signal-vol-sw = 1
;sd-uhs-sdr50 = 1
;sd-uhs-ddr50 = 1
;sd-uhs-sdr104 = 1
;vmmc="vcc-sdcv"
;vqmmc="vcc-sdcvq33"
;vdmmc="vcc-sdcvd"
max-frequency = 43000000

[wifi_para]
wifi_used = 1
wifi_sdc_id = 0
wifi_reg_on = port:PB03<1><default><default><1>
wifi_wakeup_ap = port:PB02<0><default><default><1>

[mbus]
mbus_master_config_num = 2

; RISCV - 
mbus_config_0_master = 39
mbus_config_0_master_limit = 500

; DE - 
mbus_config_1_master = 16
mbus_config_1_master_prior = 3
