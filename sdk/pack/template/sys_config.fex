;MIPI-DSI AstroToo 480x480 2-lane (NV3049F / ST7701S / JD9161)
[lcd0]
lcd_used            = 1
lcd_driver_name     = "astrotoo_lcd"
; 0: NV3049F  1: 强制沃尔康 ST7701S（不进 AUTO）  2: AUTO (0x04)  3: 强制 JD9161
; 4: 强制丰采 ST7701S HSD040BPN1
; AUTO: 30 49 03=NV, 91 61 1b=JD9161, 其余成功读回=丰采 ST7701S
lcd_panel_sel       = 2
; Keep startup dark until the app restores the saved screen state.
lcd_backlight       = 0
lcd_if              = 4
lcd_x               = 480
lcd_y               = 480
lcd_width           = 70
lcd_height          = 72
lcd_rgb_swap        = 0
; astrotoo_lcd 的 dclk/ht/hbp/vt/vbp 由程序覆盖，下面数值不生效
; NV/丰采 ST7701S(AUTO 或 sel=4)/沃尔康 ST7701S(sel=1): dclk=18 hbp=44 ht=572 hspw=4 vbp=14 vt=512 vspw=2
; JD9161（sel=3，或 AUTO 读到 91 61 1b）: dclk=16 hbp=30 ht=525 hspw=15 vbp=12 vt=512 vspw=4
lcd_dclk_freq       = 18
lcd_pwm_used        = 1
lcd_pwm_ch          = 2
lcd_pwm_freq        = 50000
lcd_pwm_pol         = 1
lcd_pwm_max_limit   = 255
lcd_hbp             = 44
lcd_ht              = 572
lcd_hspw            = 4
lcd_vbp             = 14
lcd_vt              = 512
lcd_vspw            = 2
lcd_dsi_if          = 0
lcd_dsi_slave_if    = 0
lcd_dsi_clk_if      = 0
lcd_dsi_lane        = 2
lcd_dsi_format      = 0
lcd_dsi_te          = 0
lcd_hs_trail_set    = 8
lcd_frm             = 0
lcd_io_phase        = 0x0000
lcd_gamma_en        = 0
lcd_bright_curve_en = 0
lcd_cmap_en         = 0
deu_mode            = 0
lcdgamma4iep        = 22
smart_color         = 90
lcd_gpio_reset      = port:PE03<1><0><3><default>
lcd_gpio_0          = port:PE03<1><0><3><default>
;lcd_gpio_id         = port:PE02<0><1><default><default>
lcd_gpio_1          = port:PD12<4><0><3><default>
lcd_gpio_2          = port:PD13<4><0><3><default>
